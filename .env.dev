# ===== LoreFlow 开发环境配置 =====
# 使用方式: cp .env.dev .env（dev.sh 会自动执行）

# 应用
APP_NAME=LoreFlow
APP_ENV=dev
LOG_LEVEL=INFO
WORKERS=1

# 数据库（localhost 直连；5433 避开 LoreRAG dev 库占用的 5432）
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=loreflow

# Docker 镜像坐标（本地 compose 构建用；推送见 .github/workflows/build-push.yml）
DOCKER_BACKEND_REPOSITORY=loreflow_backend
DOCKER_BACKEND_TAG=latest
DOCKER_FRONTEND_REPOSITORY=loreflow_frontend
DOCKER_FRONTEND_TAG=latest

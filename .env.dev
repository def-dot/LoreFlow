# ===== LoreFlow 开发环境配置 =====
# 使用方式: cp .env.dev .env（dev.sh 会自动执行）

# 应用
APP_NAME=LoreFlow
APP_ENV=dev
LOG_LEVEL=INFO
WORKERS=1

# 数据库（localhost 直连；5433 避开 LoreRAG dev 库占用的 5432）
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=loreflow

# RAG
EMBEDDING_DIMENSION=1024
MAX_FILE_SIZE=52428800
REDIS_PASSWORD=redis123
REDIS_URL=redis://:redis123@localhost:6380/0

# ---------- TEI ----------
TEI_EMBED_URL=http://localhost:8085
TEI_RERANK_URL=http://localhost:8084
TEI_BATCH_SIZE=16

# Embedding model and dimension
EMBEDDING_DIMENSION=1024

# Docker 镜像 tag（compose.prod.yml 构建产物：loreflow-backend / loreflow-frontend）

TAVILY_API_KEY=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

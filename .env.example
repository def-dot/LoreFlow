# ===== LoreFlow 环境配置模板 =====
# 复制为 .env.dev（本地开发）或 .env.prod（生产部署），
# 分别由 dev.sh / deploy.sh 拷贝为 .env 后生效。
#
#   cp .env.example .env.dev
#   cp .env.example .env.prod

# ---------- 应用 ----------
APP_NAME=LoreFlow                  # 应用名（FastAPI title）
APP_ENV=dev                        # dev | staging | prod（prod 关闭 /docs）
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
WORKERS=1                          # 必须为 1：多 worker 各自 lifespan 会重复恢复未完成的 run

# ---------- 数据库 ----------
# 本地开发连 localhost；生产容器内连服务名 db（见 compose.prod.yml）
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=loreflow

# ---------- Docker 镜像坐标（compose.prod.yml 使用）----------
DOCKER_BACKEND_REPOSITORY=<your-registry>/loreflow_backend
DOCKER_BACKEND_TAG=latest
DOCKER_FRONTEND_REPOSITORY=<your-registry>/loreflow_frontend
DOCKER_FRONTEND_TAG=latest

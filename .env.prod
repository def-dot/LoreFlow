# ===== LoreFlow 开发环境配置 =====
# 使用方式: cp .env.dev .env（dev.sh 会自动执行）

# 应用
APP_NAME=LoreFlow
APP_ENV=prod
LOG_LEVEL=INFO
WORKERS=1

# 数据库（localhost 直连；5433 避开 LoreRAG dev 库占用的 5432）
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=loreflow

# RAG
EMBEDDING_DIMENSION=1024
MAX_FILE_SIZE=52428800
REDIS_PASSWORD=redis123
REDIS_URL=redis://:redis123@redis:6379/0

# ---------- TEI ----------
TEI_EMBED_URL=http://tei-embed:80
TEI_RERANK_URL=http://tei-rerank:80
TEI_BATCH_SIZE=16

# ---------- Sandbox（容器间通过服务名访问） ----------
SANDBOX_URL=http://sandbox:8194

# Embedding model and dimension
EMBEDDING_DIMENSION=1024

TAVILY_API_KEY=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
NOTION_TOKEN=ntn_b26166339233pKX7BiEDVqB3RhCasPKrI6BepCx8Zod5qF

# MCP Service
MCP_SERVICE_URL=http://mcp-service:8090

# LLM Provider 预置密钥

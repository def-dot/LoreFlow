# ===== LoreFlow 生产环境配置 =====
# 使用方式: bash deploy.sh prod（会 cp .env.prod .env）
# 注意: 生产密码请替换为强密码并妥善保管

# 应用
APP_NAME=LoreFlow
APP_ENV=prod
LOG_LEVEL=INFO
WORKERS=1

# 数据库（容器网络内主机名为 db）
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-strong-password>
POSTGRES_DB=loreflow

# Docker 镜像坐标（推送到你的镜像仓库后填写）
DOCKER_BACKEND_REPOSITORY=<registry>/loreflow_backend
DOCKER_BACKEND_TAG=latest
DOCKER_FRONTEND_REPOSITORY=<registry>/loreflow_frontend
DOCKER_FRONTEND_TAG=latest

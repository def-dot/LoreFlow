{
  "mcpServers": {
    "系统监控": {
      "command": "python",
      "args": ["-m", "app.mcps.system_monitor"],
      "env": {}
    },
    "数据库": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub@latest",
        "--transport",
        "stdio",
        "--dsn",
        "postgresql://postgres:postgres@localhost:5434/loreflow?sslmode=disable"
      ],
      "env": {}
    },
    "Notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {}
    },
    "文件系统": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:/rag/LoreFlow"
      ],
      "env": {}
    }
  }
}

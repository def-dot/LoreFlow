{
  "mcpServers": {
    "系统监控": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "app/mcps/system_monitor.py"
      ],
      "env": {}
    },
    "数据库": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub@latest",
        "--transport",
        "stdio",
        "--dsn",
        "postgresql://postgres:postgres@localhost:5432/loreflow?sslmode=disable"
      ],
      "env": {}
    },
    "Notion": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    },
    "文件系统": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:/rag/LoreFlow"
      ],
      "env": {}
    }
  }
}
      "orig": "\u4eba\u5de5\u667a\u80fd\u7684\u601d\u60f3\u840c\u82bd\u53ef\u4ee5\u8ffd\u6eaf\u5230\u5341\u4e03\u4e16\u7eaa\u7684\u5df4\u65af\u5361\u548c\u83b1\u5e03\u5c3c\u8328\uff0c\u4ed6\u4eec\u8f83\u65e9\u840c\u751f\u4e86\u6709\u667a\u80fd\u7684\u673a\u5668\u7684\u60f3\u6cd5\u3002\u5341\u4e5d\u4e16 \u7eaa\uff0c\u82f1\u56fd\u6570\u5b66\u5bb6\u5e03\u5c14\u548c\u5fb7o\u6469\u5c14\u6839\u63d0\u51fa\u4e86\u201c\u601d\u7ef4\u5b9a\u5f8b\u201c\uff0c\u8fd9\u4e9b\u53ef\u8c13\u662f\u4eba\u5de5\u667a\u80fd\u7684\u5f00\u7aef\u3002\u5341\u4e5d\u4e16\u7eaa\u4e8c\u5341\u5e74\u4ee3\uff0c\u82f1 \u56fd\u79d1\u5b66\u5bb6\u5df4\u8d1d\u5947\u8bbe\u8ba1\u4e86\u7b2c\u4e00\u67b6\u201c\u8ba1\u7b97\u673a\u5668\u201c\uff0c\u5b83\u88ab\u8ba4\u4e3a\u662f\u8ba1\u7b97\u673a\u786c\u4ef6\uff0c\u4e5f\u662f\u4eba\u5de5\u667a\u80fd\u786c\u4ef6\u7684\u524d\u8eab\u3002\u7535\u5b50\u8ba1\u7b97\u673a \u7684\u95ee\u4e16\uff0c\u4f7f\u4eba\u5de5\u667a\u80fd\u7684\u7814\u7a76\u771f\u6b63\u6210\u4e3a\u53ef\u80fd\u3002",
      "text": "\u4eba\u5de5\u667a\u80fd\u7684\u601d\u60f3\u840c\u82bd\u53ef\u4ee5\u8ffd\u6eaf\u5230\u5341\u4e03\u4e16\u7eaa\u7684\u5df4\u65af\u5361\u548c\u83b1\u5e03\u5c3c\u8328\uff0c\u4ed6\u4eec\u8f83\u65e9\u840c\u751f\u4e86\u6709\u667a\u80fd\u7684\u673a\u5668\u7684\u60f3\u6cd5\u3002\u5341\u4e5d\u4e16 \u7eaa\uff0c\u82f1\u56fd\u6570\u5b66\u5bb6\u5e03\u5c14\u548c\u5fb7o\u6469\u5c14\u6839\u63d0\u51fa\u4e86\u201c\u601d\u7ef4\u5b9a\u5f8b\u201c\uff0c\u8fd9\u4e9b\u53ef\u8c13\u662f\u4eba\u5de5\u667a\u80fd\u7684\u5f00\u7aef\u3002\u5341\u4e5d\u4e16\u7eaa\u4e8c\u5341\u5e74\u4ee3\uff0c\u82f1 \u56fd\u79d1\u5b66\u5bb6\u5df4\u8d1d\u5947\u8bbe\u8ba1\u4e86\u7b2c\u4e00\u67b6\u201c\u8ba1\u7b97\u673a\u5668\u201c\uff0c\u5b83\u88ab\u8ba4\u4e3a\u662f\u8ba1\u7b97\u673a\u786c\u4ef6\uff0c\u4e5f\u662f\u4eba\u5de5\u667a\u80fd\u786c\u4ef6\u7684\u524d\u8eab\u3002\u7535\u5b50\u8ba1\u7b97\u673a \u7684\u95ee\u4e16\uff0c\u4f7f\u4eba\u5de5\u667a\u80fd\u7684\u7814\u7a76\u771f\u6b63\u6210\u4e3a\u53ef\u80fd\u3002"
    },
